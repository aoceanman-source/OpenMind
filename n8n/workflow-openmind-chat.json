    {
      "parameters": {
        "jsCode": "// [S1] 訊息類型檢查、[B2] 長度限制、[B3] Rate Limiting\nconst body = $input.item.json.body || $input.item.json;\nconst message = body.message || '';\nconst sessionId = body.sessionId || 'unknown';\n\n// S1: 驗證 message 為非空字串\nif (!message || typeof message !== 'string') {\n  return [{ json: { ...body, isValid: false, errorMessage: '請輸入您的問題，謝謝！' } }];\n}\n\n// B2: 訊息長度上限 500 字\nif (message.length > 500) {\n  return [{ json: { ...body, isValid: false, errorMessage: '訊息過長（超過500字），請簡短描述問題，謝謝。' } }];\n}\n\n// B3: Rate Limiting（每分鐘最多 10 則）\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.rateLimits) staticData.rateLimits = {};\n\nconst now = Date.now();\nconst windowMs = 60 * 1000;\nconst maxRequests = 10;\n\nconst userLimits = staticData.rateLimits[sessionId] || { count: 0, windowStart: now };\nif (now - userLimits.windowStart > windowMs) {\n  userLimits.count = 0;\n  userLimits.windowStart = now;\n}\nuserLimits.count++;\nstaticData.rateLimits[sessionId] = userLimits;\n\n// 定期清理過期資料\nconst entries = Object.entries(staticData.rateLimits);\nif (entries.length > 500) {\n  staticData.rateLimits = Object.fromEntries(\n    entries.filter(([, v]) => now - v.windowStart < windowMs * 10)\n  );\n}\n\nif (userLimits.count > maxRequests) {\n  return [{ json: { ...body, isValid: false, errorMessage: '您的訊息頻率過高，請稍後 1 分鐘再試。' } }];\n}\n\nreturn [{ json: { ...body, isValid: true, errorMessage: null } }];"
      },
