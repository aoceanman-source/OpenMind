    {
      "parameters": {
        "jsCode": "// [B2] Prompt Injection 防護 + [B6] 錯誤處理\nconst output = $input.item.json.output || '';\nconst webhookBody = $('Chat Webhook').item.json.body || $('Chat Webhook').item.json;\nconst rawInput = webhookBody.message || '';\n\n// B2: 偵測用戶輸入中的 LEAD_DATA 注入嘗試\nif (rawInput.toUpperCase().includes('LEAD_DATA:')) {\n  return [{ json: {\n    output: '很抱歉，您的訊息包含無效內容，請重新描述您的需求。',\n    leadData: null,\n    hasLead: false\n  }}];\n}\n\nconst markerIndex = output.indexOf('LEAD_DATA:');\nlet leadData = null;\nlet cleanMessage = output;\n\nif (markerIndex !== -1) {\n  const jsonStart = markerIndex + 'LEAD_DATA:'.length;\n  const jsonEnd = output.indexOf('\\n', jsonStart);\n  const jsonStr = jsonEnd === -1 ? output.slice(jsonStart) : output.slice(jsonStart, jsonEnd);\n  try {\n    leadData = JSON.parse(jsonStr.trim());\n    const before = output.slice(0, markerIndex).trim();\n    const after = jsonEnd !== -1 ? output.slice(jsonEnd + 1).trim() : '';\n    cleanMessage = (before + '\\n' + after).trim();\n  } catch(e) {\n    cleanMessage = '系統處理發生問題，請重新提供您的聯絡資料，謝謝。';\n  }\n}\n\n// B6: 確保回覆內容不為空\nif (!cleanMessage || cleanMessage.trim() === '') {\n  cleanMessage = '抱歉，系統發生問題，請稍後重試。';\n}\n\nreturn [{ json: { output: cleanMessage, leadData, hasLead: leadData !== null } }];"
      },
